# OpenAlex requires a key for live searches.
OPENALEX_API_KEY=

# ORCID OAuth credentials. Use sandbox.orcid.org credentials while testing.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://127.0.0.1:4173/api/orcid/callback

# Optional local service port.
PORT=4173

# The first account created with this email becomes the platform manager.
SETU_BOOTSTRAP_MANAGER_EMAIL=
